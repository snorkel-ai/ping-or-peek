.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# Credentials for model calls; never committed.
.env
# Generated by `ping-or-peek tasks`; tests/golden/ holds one reference copy.
/tasks/
# Harbor job output never lives in the repo.
/jobs/
# Per-trial label results carry annotator rationales, which can paraphrase agent reasoning.
# They are private evidence: never commit them. The export (episodes.parquet) holds none.
s0/
*.private.json
# The full export and the files `ping-or-peek export` writes beside it stay local, wherever
# --out-dir puts them: the dataset build reads the export. The notebook reads the public Hugging
# Face dataset instead, whose card documents its columns.
episodes.parquet
DATA_CARD.md
provenance.json
infrastructure_attempts.json
